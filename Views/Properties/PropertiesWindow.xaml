<Window
    x:Class="FastExplorer.Views.Properties.PropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FastExplorer"
    mc:Ignorable="d"
    Title="プロパティ">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 自作タイトルバー (｢プロパティ｣タイトル表示 & 全域ドラッグ可能) -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="Transparent"
              Padding="14,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左端タイトル -->
            <TextBlock Text="プロパティ"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- ドラッグ可能領域 -->
            <Grid Grid.Column="1" Background="Transparent"/>
        </Grid>

        <!-- 2. プロパティタブバー -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,4,14,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="TabBtnGeneral"
                              Content="全般"
                              IsChecked="True"
                              Click="TabButton_Click"
                              Tag="General"
                              Padding="12,5"
                              CornerRadius="4"
                              FontSize="12.5"
                              FontWeight="Medium"/>
                <ToggleButton x:Name="TabBtnSignatures"
                              Content="デジタル署名"
                              IsChecked="False"
                              Click="TabButton_Click"
                              Tag="Signatures"
                              Padding="12,5"
                              CornerRadius="4"
                              FontSize="12.5"
                              FontWeight="Medium"
                              Visibility="Collapsed"/>
                <ToggleButton x:Name="TabBtnSecurity"
                              Content="セキュリティ"
                              IsChecked="False"
                              Click="TabButton_Click"
                              Tag="Security"
                              Padding="12,5"
                              CornerRadius="4"
                              FontSize="12.5"
                              FontWeight="Medium"/>
                <ToggleButton x:Name="TabBtnDetails"
                              Content="詳細"
                              IsChecked="False"
                              Click="TabButton_Click"
                              Tag="Details"
                              Padding="12,5"
                              CornerRadius="4"
                              FontSize="12.5"
                              FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <!-- 3. コンテンツエリア -->
        <Grid Grid.Row="2" Margin="2,0">
            <!-- 【タブ1: 全般】 -->
            <ScrollViewer x:Name="GeneralTabContent" VerticalScrollBarVisibility="Auto" Padding="18,12,18,12" Visibility="Visible">
                <StackPanel Spacing="8">
                    <!-- ヘッダー (アイコン + ファイル名) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="42" Height="42" VerticalAlignment="Center">
                            <Image x:Name="HeaderImageIcon" Width="42" Height="42" Stretch="Uniform"/>
                            <FontIcon x:Name="HeaderFontIcon" Glyph="&#xE7C3;" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBox x:Name="NameTextBox"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Padding="6,4"
                                     CornerRadius="4"
                                     HorizontalAlignment="Stretch"
                                     LostFocus="NameTextBox_LostFocus"
                                     KeyDown="NameTextBox_KeyDown"/>
                            <TextBlock x:Name="NameTextBlock"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>

                    <!-- ドライブ専用パネル -->
                    <StackPanel x:Name="DrivePanel" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="種類:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="DriveTypeText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="ファイル システム:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="DriveFileSystemText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="使用領域:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="DriveUsedSpaceText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="空き領域:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="DriveFreeSpaceText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="容量:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="DriveTotalSpaceText" FontWeight="SemiBold" FontSize="12.5" IsTextSelectionEnabled="True"/>
                        </Grid>
                        <ProgressBar x:Name="DriveProgressBar" Height="6" CornerRadius="3" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- ファイル/フォルダー共通パネル -->
                    <StackPanel x:Name="FileFolderPanel" Spacing="8">
                        <!-- ファイルの種類 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="ファイルの種類:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="ItemTypeTextBlock" FontSize="12.5" IsTextSelectionEnabled="True"/>
                        </Grid>

                        <!-- プログラム (開くアプリ + 変更ボタン) -->
                        <Grid x:Name="OpensWithRow" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="プログラム:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="OpensWithText" FontSize="12.5" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                            <Button Grid.Column="2"
                                    x:Name="ChangeProgramButton"
                                    Content="変更(C)..."
                                    FontSize="11.5"
                                    Padding="10,3"
                                    Click="ChangeProgramButton_Click"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>

                        <!-- 場所 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="場所:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="LocationText" FontSize="12.5" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </Grid>

                        <!-- サイズ -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="サイズ:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="SizeText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                            <ProgressRing Grid.Column="2" x:Name="SizeProgressRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed"/>
                        </Grid>

                        <!-- ディスク上のサイズ -->
                        <Grid x:Name="SizeOnDiskRow" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="ディスク上のサイズ:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="SizeOnDiskText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                        </Grid>

                        <!-- 内容 (フォルダー/複数選択時) -->
                        <Grid x:Name="ContainsRow" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="内容:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                            <TextBlock Grid.Column="1" x:Name="ContainsText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>

                        <!-- 日時情報 -->
                        <StackPanel x:Name="DatesPanel" Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="作成日時:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" x:Name="DateCreatedText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="更新日時:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" x:Name="DateModifiedText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="アクセス日時:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" x:Name="DateAccessedText" FontSize="12.5" IsTextSelectionEnabled="True"/>
                            </Grid>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>

                        <!-- 属性 -->
                        <Grid x:Name="AttributesRow" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="属性:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                                <CheckBox x:Name="ReadOnlyCheckBox" Content="読み取り専用(R)" FontSize="12.5" IsThreeState="False" Checked="Attribute_Changed" Unchecked="Attribute_Changed"/>
                                <CheckBox x:Name="HiddenCheckBox" Content="隠しファイル(H)" FontSize="12.5" IsThreeState="False" Checked="Attribute_Changed" Unchecked="Attribute_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 【タブ2: デジタル署名】 (署名がある場合のみ表示) -->
            <ScrollViewer x:Name="SignaturesTabContent" VerticalScrollBarVisibility="Auto" Padding="18,12,18,12" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="署名の一覧:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5"/>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ListView x:Name="SignaturesListView" SelectionMode="None">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" Padding="8,6" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="署名者名" FontWeight="SemiBold" FontSize="11.5"/>
                                        <TextBlock Grid.Column="1" Text="ダイジェスト" FontWeight="SemiBold" FontSize="11.5"/>
                                        <TextBlock Grid.Column="2" Text="タイムスタンプ" FontWeight="SemiBold" FontSize="11.5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DigitalSignatureItem">
                                    <Grid ColumnSpacing="8" Padding="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind SignerName}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind DigestAlgorithm}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Timestamp}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 【タブ3: セキュリティ】 -->
            <ScrollViewer x:Name="SecurityTabContent" VerticalScrollBarVisibility="Auto" Padding="18,12,18,12" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="オブジェクト名:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="SecurityObjectPathText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>

                    <TextBlock Text="グループ名またはユーザー名(G):" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" MaxHeight="185">
                        <ListView x:Name="SecurityPrincipalsListView"
                                  SelectionMode="Single"
                                  SelectionChanged="SecurityPrincipalsListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:SecurityPrincipalPermission">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <TextBlock x:Name="PermissionsForUserText" Text="アクセス許可:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12,10">
                        <StackPanel Spacing="7">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="アクセス許可" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="許可" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="フル コントロール" FontSize="12.5"/>
                                <FontIcon Grid.Column="1" x:Name="PermFullControl" Glyph="&#xE73E;" FontSize="13" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="変更" FontSize="12.5"/>
                                <FontIcon Grid.Column="1" x:Name="PermModify" Glyph="&#xE73E;" FontSize="13" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="読み取りと実行" FontSize="12.5"/>
                                <FontIcon Grid.Column="1" x:Name="PermReadAndExecute" Glyph="&#xE73E;" FontSize="13" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="読み取り" FontSize="12.5"/>
                                <FontIcon Grid.Column="1" x:Name="PermRead" Glyph="&#xE73E;" FontSize="13" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Text="書き込み" FontSize="12.5"/>
                                <FontIcon Grid.Column="1" x:Name="PermWrite" Glyph="&#xE73E;" FontSize="13" HorizontalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 【タブ4: 詳細】 -->
            <ScrollViewer x:Name="DetailsTabContent" VerticalScrollBarVisibility="Auto" Padding="18,12,18,12" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" MaxHeight="300">
                        <ListView x:Name="DetailsListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileDetailProperty">
                                    <Grid ColumnSpacing="12" Padding="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   IsTextSelectionEnabled="True"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Value}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- ハッシュ値領域 -->
                    <TextBlock Text="チェックサム / ハッシュ値:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12,10">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="SHA-256:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Click="CopySha256Button_Click" ToolTipService.ToolTip="コピー" Padding="6,2" FontSize="11" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                </Button>
                            </Grid>
                            <TextBox x:Name="Sha256TextBox" IsReadOnly="True" FontSize="11" FontFamily="Consolas, Cascadia Code" CornerRadius="4"/>

                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="MD5:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Click="CopyMd5Button_Click" ToolTipService.ToolTip="コピー" Padding="6,2" FontSize="11" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                </Button>
                            </Grid>
                            <TextBox x:Name="Md5TextBox" IsReadOnly="True" FontSize="11" FontFamily="Consolas, Cascadia Code" CornerRadius="4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 4. 下部アクションバー (OK / キャンセル / 適用) -->
        <Border Grid.Row="3"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="OkButton"
                        Content="OK"
                        Width="88"
                        Height="32"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OkButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="キャンセル"
                        Width="88"
                        Height="32"
                        Click="CancelButton_Click"/>
                <Button x:Name="ApplyButton"
                        Content="適用(A)"
                        Width="88"
                        Height="32"
                        IsEnabled="False"
                        Click="ApplyButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
