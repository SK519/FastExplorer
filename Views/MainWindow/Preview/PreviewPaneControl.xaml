<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FastExplorer.Views.MainWindow.Preview.PreviewPaneControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Resources/LayoutTemplates.xaml"/>
    </UserControl.Resources>

    <Grid x:Name="PreviewPaneGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ヘッダー -->
        <Border Grid.Row="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8FF;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="詳細とプレビュー" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
                <Button Style="{StaticResource HeaderIconButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click" ToolTipService.ToolTip="閉じる" Width="26" Height="26">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </Grid>
        </Border>
        <!-- スクロール可能コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
            <StackPanel Spacing="12">
                <!-- プレビューエリア -->
                <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MinHeight="160" MaxHeight="220" Padding="8">
                    <Grid>
                        <!-- 画像プレビュー -->
                        <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <!-- テキストプレビュー -->
                        <ScrollViewer x:Name="PreviewTextScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <TextBlock x:Name="PreviewTextBlock" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </ScrollViewer>
                        <!-- アイコンプレビュー (通常ファイル / フォルダー / 複数選択時) -->
                        <Grid x:Name="PreviewLargeIconGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="PreviewLargeImageIcon" Width="64" Height="64"/>
                            <FontIcon x:Name="PreviewLargeFontIcon" Glyph="&#xE838;" FontSize="64" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
                <!-- アイテム名 & 基本種別 -->
                <StackPanel Spacing="3">
                    <TextBlock x:Name="PreviewItemNameText" Text="アイテム未選択" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="PreviewItemTypeText" Text="-" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <!-- 簡易プロパティ一覧 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="プロパティ" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <!-- サイズ -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="サイズ" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PreviewItemSizeText" Grid.Column="1" Text="-" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </Grid>
                    <!-- 更新日時 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="更新日時" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PreviewItemModifiedText" Grid.Column="1" Text="-" FontSize="12" IsTextSelectionEnabled="True"/>
                    </Grid>
                    <!-- 作成日時 -->
                    <Grid x:Name="PreviewCreatedRow" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="作成日時" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PreviewItemCreatedText" Grid.Column="1" Text="-" FontSize="12" IsTextSelectionEnabled="True"/>
                    </Grid>
                    <!-- 解像度 (画像のみ) -->
                    <Grid x:Name="PreviewResolutionRow" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="解像度" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PreviewItemResolutionText" Grid.Column="1" Text="-" FontSize="12" IsTextSelectionEnabled="True"/>
                    </Grid>
                    <!-- 属性 -->
                    <Grid x:Name="PreviewAttributesRow" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="属性" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PreviewItemAttributesText" Grid.Column="1" Text="-" FontSize="12" IsTextSelectionEnabled="True"/>
                    </Grid>
                    <!-- 場所 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="場所" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PreviewItemPathText" Grid.Column="1" Text="-" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Grid.Column="2" Style="{StaticResource HeaderIconButtonStyle}" Width="22" Height="22" Click="PreviewCopyPathButton_Click" ToolTipService.ToolTip="パスをコピー">
                            <FontIcon Glyph="&#xE8C8;" FontSize="10"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
