<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 3. 特大アイコン表示テンプレート (GridView 用) -->
    <DataTemplate x:Key="ExtraLargeIconsItemTemplate">
        <Grid Width="180" Height="190" Padding="8,8" Opacity="{Binding Opacity}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Visibility="{Binding CheckBoxVisibility}"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      MinWidth="0" MinHeight="0" Padding="0" Margin="8,8,0,0"/>

            <Image Grid.Row="0"
                   Source="{Binding Icon}"
                   Width="128"
                   Height="128"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Grid Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Name}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Visibility="{Binding DisplayNameVisibility}"/>
                <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                         FontSize="12"
                         Height="28"
                         Padding="4,2"
                         HorizontalAlignment="Stretch"
                         Visibility="{Binding RenameBoxVisibility, FallbackValue=Collapsed}"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus"
                         Loaded="RenameBox_Loaded"/>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- 4. 大アイコン表示テンプレート (GridView 用) -->
    <DataTemplate x:Key="LargeIconsItemTemplate">
        <Grid Width="120" Height="130" Padding="6,6" Opacity="{Binding Opacity}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Visibility="{Binding CheckBoxVisibility}"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      MinWidth="0" MinHeight="0" Padding="0" Margin="8,8,0,0"/>

            <Image Grid.Row="0"
                   Source="{Binding Icon}"
                   Width="72"
                   Height="72"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Grid Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Name}"
                           FontSize="11.5"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Visibility="{Binding DisplayNameVisibility}"/>
                <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                         FontSize="11.5"
                         Height="26"
                         Padding="4,2"
                         HorizontalAlignment="Stretch"
                         Visibility="{Binding RenameBoxVisibility, FallbackValue=Collapsed}"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus"
                         Loaded="RenameBox_Loaded"/>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- 5. 中アイコン表示テンプレート (GridView 用) -->
    <DataTemplate x:Key="MediumIconsItemTemplate">
        <Grid Width="96" Height="104" Padding="4,4" Opacity="{Binding Opacity}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Visibility="{Binding CheckBoxVisibility}"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      MinWidth="0" MinHeight="0" Padding="0" Margin="6,6,0,0"/>

            <Image Grid.Row="0"
                   Source="{Binding Icon}"
                   Width="48"
                   Height="48"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Grid Grid.Row="1" Margin="0,2,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Name}"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Visibility="{Binding DisplayNameVisibility}"/>
                <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                         FontSize="11"
                         Height="24"
                         Padding="3,1"
                         HorizontalAlignment="Stretch"
                         Visibility="{Binding RenameBoxVisibility, FallbackValue=Collapsed}"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus"
                         Loaded="RenameBox_Loaded"/>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- 6. 小アイコン表示テンプレート (GridView 用) -->
    <DataTemplate x:Key="SmallIconsItemTemplate">
        <Grid Width="160" Height="34" Padding="4,4,6,4" ColumnSpacing="6" Opacity="{Binding Opacity}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Visibility="{Binding CheckBoxVisibility}"
                      MinWidth="0" MinHeight="0" Padding="0" Margin="8,0,6,0" VerticalAlignment="Center"/>

            <Image Grid.Column="1"
                   Source="{Binding Icon}"
                   Width="18"
                   Height="18"
                   VerticalAlignment="Center"/>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DisplayNameVisibility}"/>
                <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                         FontSize="12"
                         Height="26"
                         Padding="3,1"
                         Visibility="{Binding RenameBoxVisibility, FallbackValue=Collapsed}"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus"
                         Loaded="RenameBox_Loaded"/>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- 7. 一覧表示テンプレート (GridView 用) -->
    <DataTemplate x:Key="ListItemTemplate">
        <Grid Width="180" Height="32" Padding="4,4,6,4" ColumnSpacing="6" Opacity="{Binding Opacity}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Visibility="{Binding CheckBoxVisibility}"
                      MinWidth="0" MinHeight="0" Padding="0" Margin="8,0,6,0" VerticalAlignment="Center"/>

            <Image Grid.Column="1"
                   Source="{Binding Icon}"
                   Width="18"
                   Height="18"
                   VerticalAlignment="Center"/>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DisplayNameVisibility}"/>
                <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                         FontSize="12"
                         Height="26"
                         Padding="3,1"
                         Visibility="{Binding RenameBoxVisibility, FallbackValue=Collapsed}"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus"
                         Loaded="RenameBox_Loaded"/>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- 8. タイル表示テンプレート (GridView 用) -->
    <DataTemplate x:Key="TilesItemTemplate">
        <Grid Width="270" Height="62" Padding="6,4,8,4" ColumnSpacing="10" Opacity="{Binding Opacity}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Visibility="{Binding CheckBoxVisibility}"
                      MinWidth="0" MinHeight="0" Padding="0" Margin="4,0,4,0" VerticalAlignment="Center"/>

            <Image Grid.Column="1"
                   Source="{Binding Icon}"
                   Width="40"
                   Height="40"
                   VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding DisplayNameVisibility}"/>
                    <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                             FontSize="12.5"
                             Height="26"
                             Padding="3,1"
                             Visibility="{Binding RenameBoxVisibility, FallbackValue=Collapsed}"
                             KeyDown="RenameBox_KeyDown"
                             LostFocus="RenameBox_LostFocus"
                             Loaded="RenameBox_Loaded"/>
                </Grid>
                <!-- 通常ファイル/フォルダーの場合: 種類 (FileType) -->
                <TextBlock Text="{Binding FileType}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding FileTypeVisibility}"/>
                <!-- ドライブの場合: プログレスバー & 空き容量テキスト -->
                <StackPanel Spacing="3" Visibility="{Binding DriveSpaceVisibility}">
                    <ProgressBar Value="{Binding DrivePercent}" Maximum="100" Height="6" MinHeight="6" CornerRadius="3" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock Text="{Binding DriveSpaceText}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
