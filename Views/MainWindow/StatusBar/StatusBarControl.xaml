<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FastExplorer.Views.MainWindow.StatusBar.StatusBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Resources/LayoutTemplates.xaml"/>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,4,10,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusTextBlock" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="準備完了"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="StatusBtnDetailsView" Style="{StaticResource HeaderIconButtonStyle}" Width="28" Height="26" Click="StatusBtnDetailsView_Click" ToolTipService.ToolTip="詳細表示">
                <FontIcon Glyph="&#xE8BC;" FontSize="12"/>
            </Button>
            <Button x:Name="StatusBtnIconsView" Style="{StaticResource HeaderIconButtonStyle}" Width="28" Height="26" Click="StatusBtnIconsView_Click" ToolTipService.ToolTip="アイコン表示">
                <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
            </Button>
            <Rectangle Width="1" Height="14" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0"/>
            <Button x:Name="StatusBtnZoomOut" Style="{StaticResource HeaderIconButtonStyle}" Width="26" Height="26" Click="StatusBtnZoomOut_Click" ToolTipService.ToolTip="縮小">
                <TextBlock Text="－" FontSize="12" FontWeight="Bold"/>
            </Button>
            <Button x:Name="StatusBtnZoomIn" Style="{StaticResource HeaderIconButtonStyle}" Width="26" Height="26" Click="StatusBtnZoomIn_Click" ToolTipService.ToolTip="拡大">
                <FontIcon Glyph="&#xE710;" FontSize="11"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
