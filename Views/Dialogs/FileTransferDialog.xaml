<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FastExplorer.Views.Dialogs.FileTransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ThemeShadow x:Key="TransferDialogShadow" />
    </UserControl.Resources>

    <Border Width="470"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22,18"
            Shadow="{StaticResource TransferDialogShadow}"
            Translation="0,0,32">
        <StackPanel Spacing="12">
            <!-- ヘッダー (タイトル、パーセント、一時停止・キャンセルボタン) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:Name="DialogTitleText" Text="アイテムをコピー中" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="ItemsSummaryText" Text="計算中..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>

                <!-- 操作ボタン群 (一時停止 & キャンセル) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button x:Name="BtnPauseResume" Click="BtnPauseResume_Click" Width="32" Height="32" Padding="0" CornerRadius="6" ToolTipService.ToolTip="一時停止">
                        <FontIcon x:Name="IconPauseResume" Glyph="&#xE769;" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnCancel" Click="BtnCancel_Click" Width="32" Height="32" Padding="0" CornerRadius="6" ToolTipService.ToolTip="キャンセル">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- プログレスバー -->
            <ProgressBar x:Name="TransferProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" CornerRadius="3" IsIndeterminate="True"/>

            <!-- 速度・残り時間情報 -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 速度 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B0;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SpeedText" Text="-- MB/秒" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <!-- 残り時間 -->
                <TextBlock Grid.Column="1" x:Name="RemainingTimeText" Text="残り時間を計算中..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>

            <!-- 現在処理中のファイルとパス情報 -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentFileNameText" Text="準備中..." FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PathInfoText" Text="" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 詳細情報の展開/折りたたみボタン -->
            <Button x:Name="BtnToggleDetails" Click="BtnToggleDetails_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,2" Margin="-4,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="IconDetailsChevron" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="DetailsToggleText" Text="詳細情報を表示" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- 速度グラフエリア (展開時) -->
            <Grid x:Name="SpeedGraphSection" Visibility="Collapsed" Height="110" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                <!-- ピーク速度 / 0速度 表示 -->
                <TextBlock x:Name="PeakSpeedText" Text="100 MB/秒" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                <TextBlock Text="0 MB/秒" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                <!-- 速度グラフ本体 (Polygon / Polyline) -->
                <Canvas x:Name="GraphCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,14,0,14" SizeChanged="GraphCanvas_SizeChanged">
                    <Polygon x:Name="GraphPolygon" Fill="{ThemeResource AccentFillColorTertiaryBrush}" Opacity="0.35"/>
                    <Polyline x:Name="GraphPolyline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"/>
                </Canvas>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
