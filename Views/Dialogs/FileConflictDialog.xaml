<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FastExplorer.Views.Dialogs.FileConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ファイルの置換またはスキップ"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    CornerRadius="8">

    <Grid MinWidth="440" MaxWidth="520" RowSpacing="16" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メッセージ -->
        <TextBlock Grid.Row="0"
                   x:Name="MessageTextBlock"
                   Text="宛先には既に同じ名前のファイルが存在します。"
                   FontSize="13"
                   TextWrapping="Wrap"/>

        <!-- 衝突ファイル比較カード -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ソースファイル情報 (コピー元) -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SourceFileNameText" Text="source_file.txt" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SourceFileInfoText" Text="コピー元: 1.2 MB - 2026/08/16 22:00" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,-4"/>

                <!-- 宛先ファイル情報 (既存) -->
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DestFileNameText" Text="dest_file.txt" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DestFileInfoText" Text="宛先 (既存): 1.2 MB - 2026/08/10 15:30" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- アクションボタン群 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <!-- 1. 置き換える -->
            <Button x:Name="BtnReplace"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="12,10"
                    CornerRadius="6"
                    Click="BtnReplace_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE898;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="宛先のファイルを置き換える" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="既存のファイルを新しいファイルで上書きします" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 2. スキップ -->
            <Button x:Name="BtnSkip"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="12,10"
                    CornerRadius="6"
                    Click="BtnSkip_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="このファイルをスキップする" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="既存のファイルをそのまま残し、コピー／移動を行いません" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 3. 両方のファイルを保持する -->
            <Button x:Name="BtnKeepBoth"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="12,10"
                    CornerRadius="6"
                    Click="BtnKeepBoth_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8C8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="両方のファイルを保持する" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="自動的に連番を付与して新しいファイルとして保存します" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>

        <!-- 一括適用チェックボックス -->
        <CheckBox Grid.Row="3"
                  x:Name="ApplyToAllCheckBox"
                  Content="現在の競合すべてに同じ処理を適用する"
                  FontSize="12"
                  Margin="4,0,0,0"/>
    </Grid>
</ContentDialog>
