<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FastExplorer.Views.MainWindow.Home.HomeViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer x:Name="HomeViewScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,12">
        <StackPanel Spacing="22" MaxWidth="1600" HorizontalAlignment="Stretch">
            <!-- セクション 1: クイック アクセス -->
            <StackPanel Spacing="8">
                <Button x:Name="BtnToggleQuickAccessSection" Click="ToggleQuickAccessSection_Click" Background="Transparent" BorderThickness="0" Padding="4,2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="IconQuickAccessChevron" Glyph="&#xE70D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="クイック アクセス" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <!-- クイックアクセスタイル一覧 -->
                <GridView x:Name="HomeQuickAccessGridView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="HomeQuickAccessGridView_ItemClick" ContextRequested="HomeQuickAccessGridView_ContextRequested" Padding="0"
                          CanDragItems="True" AllowDrop="True" DragItemsStarting="HomeQuickAccess_DragItemsStarting" DragOver="HomeQuickAccess_DragOver" Drop="HomeQuickAccess_Drop">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="236" ItemHeight="60"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,8,8"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="236" Height="58" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- アイコン (シェルアイコン) -->
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center"/>
                                    <!-- 名前と場所 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- ピン留めマーク -->
                                    <FontIcon Grid.Column="2" Glyph="&#xE718;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
            <!-- セクション 2: 最近使用した項目 / お気に入り / 共有 -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE70D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="HomeTabBtnRecent" Click="HomeTabRecent_Click" Height="32" CornerRadius="16" Padding="12,0" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="12"/>
                            <TextBlock Text="最近使用した項目" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeTabBtnFavorites" Click="HomeTabFavorites_Click" Height="32" CornerRadius="16" Padding="12,0" Background="{ThemeResource SubtleFillColorTransparentBrush}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE734;" FontSize="12"/>
                            <TextBlock Text="お気に入り" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeTabBtnShared" Click="HomeTabShared_Click" Height="32" CornerRadius="16" Padding="12,0" Background="{ThemeResource SubtleFillColorTransparentBrush}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72D;" FontSize="12"/>
                            <TextBlock Text="共有" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- 最近のアクティビティ空状態 -->
                <Grid x:Name="HomeRecentEmptyStateGrid" HorizontalAlignment="Center" Margin="0,32,0,20">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="440">
                        <Border Width="88" Height="64" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE90F;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Width="18" Height="18" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                                    <FontIcon Glyph="&#xE946;" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="最近のアクティビティを表示できません" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="最近使用したファイルをここに表示するには、エクスプローラーにアクセス許可が必要です。" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <HyperlinkButton Content="フォルダー オプションでプライバシー設定を開きます" HorizontalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Click="HomeOpenPrivacySettings_Click"/>
                    </StackPanel>
                </Grid>
                <!-- 最近のファイル一覧 (取得できた場合) -->
                <ListView x:Name="HomeRecentListView" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="HomeRecentListView_ItemClick" ContextRequested="HomeRecentListView_ContextRequested" Padding="0" CanDragItems="True" DragItemsStarting="FileList_DragItemsStarting">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <!-- アイコン / サムネイル -->
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding FormattedDateModified}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
