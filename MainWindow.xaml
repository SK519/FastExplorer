<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FastExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FastExplorer.Models"
    xmlns:dialogs="using:FastExplorer.Views.Dialogs"
    xmlns:nav="using:FastExplorer.Views.MainWindow.Navigation"
    xmlns:toolbar="using:FastExplorer.Views.MainWindow.Toolbar"
    xmlns:header="using:FastExplorer.Views.MainWindow.FileList"
    xmlns:home="using:FastExplorer.Views.MainWindow.Home"
    xmlns:preview="using:FastExplorer.Views.MainWindow.Preview"
    xmlns:status="using:FastExplorer.Views.MainWindow.StatusBar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FastExplorer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Resources/ContextMenuResources.xaml"/>
                    <ResourceDictionary Source="ms-appx:///Resources/FileItemDetailsTemplates.xaml"/>
                    <ResourceDictionary Source="ms-appx:///Resources/FileItemGridTemplates.xaml"/>
                    <ResourceDictionary Source="ms-appx:///Resources/FileItemGridScaledTemplates.xaml"/>
                    <ResourceDictionary Source="ms-appx:///Resources/LayoutTemplates.xaml"/>
                </ResourceDictionary.MergedDictionaries>

                <!-- 選択アイテム用 Win11 風コンテキストメニュー -->
                <Flyout x:Key="ItemContextMenu" x:Name="ItemContextMenu" Placement="BottomEdgeAlignedLeft" Opening="ItemContextMenu_Opening" Closed="ItemContextMenu_Closed">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="4"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MaxHeight" Value="520"/>
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel x:Name="ContextMenuRootPanel" Spacing="3" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" PointerWheelChanged="ContextMenuScrollViewer_PointerWheelChanged">
                        <Border x:Name="ContextMenuHeaderBorder" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="2,0,2,2" PointerEntered="ContextMenuHeader_PointerEntered">
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                <Button Style="{StaticResource HeaderIconButtonStyle}" Click="ContextMenuCut_Click" ToolTipService.ToolTip="切り取り (Ctrl+X)"><FontIcon Glyph="&#xE8C6;" FontSize="14"/></Button>
                                <Button Style="{StaticResource HeaderIconButtonStyle}" Click="ContextMenuCopy_Click" ToolTipService.ToolTip="コピー (Ctrl+C)"><FontIcon Glyph="&#xE8C8;" FontSize="14"/></Button>
                                <Button x:Name="HeaderBtnPaste" Style="{StaticResource HeaderIconButtonStyle}" Click="ContextMenuPaste_Click" ToolTipService.ToolTip="貼り付け (Ctrl+V)"><FontIcon Glyph="&#xE77F;" FontSize="14"/></Button>
                                <Button Style="{StaticResource HeaderIconButtonStyle}" Click="ContextMenuRename_Click" ToolTipService.ToolTip="名前の変更 (F2)"><FontIcon Glyph="&#xE8AC;" FontSize="14"/></Button>
                                <Button Style="{StaticResource HeaderIconButtonStyle}" Click="ContextMenuDelete_Click" ToolTipService.ToolTip="削除 (ゴミ箱へ)"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                                <Button Style="{StaticResource HeaderIconButtonStyle}" Click="ContextMenuProperties_Click" ToolTipService.ToolTip="プロパティ (Alt+Enter)"><FontIcon Glyph="&#xE90F;" FontSize="14"/></Button>
                            </StackPanel>
                        </Border>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,2"/>
                        <ScrollViewer x:Name="ContextMenuScrollViewer" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="ContextMenuScrollViewer_PointerWheelChanged">
                            <StackPanel x:Name="ContextMenuItemsPanel" Spacing="2" Margin="0"/>
                        </ScrollViewer>
                    </StackPanel>
                </Flyout>

                <!-- 背景右クリック用コンテキストメニュー -->
                <MenuFlyout x:Key="BackgroundContextMenu" x:Name="BackgroundContextMenu" Opening="BackgroundContextMenu_Opening">
                    <MenuFlyoutSubItem Text="表示">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A9;" /></MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem x:Name="MenuBgViewExtraLarge" Text="特大アイコン" GroupName="BgViewModeGroup" Click="ViewModeExtraLarge_Click"/>
                        <RadioMenuFlyoutItem x:Name="MenuBgViewLarge" Text="大アイコン" GroupName="BgViewModeGroup" Click="ViewModeLarge_Click"/>
                        <RadioMenuFlyoutItem x:Name="MenuBgViewMedium" Text="中アイコン" GroupName="BgViewModeGroup" Click="ViewModeMedium_Click"/>
                        <RadioMenuFlyoutItem x:Name="MenuBgViewSmall" Text="小アイコン" GroupName="BgViewModeGroup" Click="ViewModeSmall_Click"/>
                        <RadioMenuFlyoutItem x:Name="MenuBgViewList" Text="一覧" GroupName="BgViewModeGroup" Click="ViewModeList_Click"/>
                        <RadioMenuFlyoutItem x:Name="MenuBgViewDetails" Text="詳細" GroupName="BgViewModeGroup" Click="ViewModeDetails_Click"/>
                        <RadioMenuFlyoutItem x:Name="MenuBgViewTiles" Text="タイル" GroupName="BgViewModeGroup" Click="ViewModeTiles_Click"/>
                        <RadioMenuFlyoutItem x:Name="MenuBgViewContent" Text="コンテンツ" GroupName="BgViewModeGroup" Click="ViewModeContent_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="拡大 (Ctrl + +)" Click="ViewZoomIn_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="縮小 (Ctrl + -)" Click="ViewZoomOut_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE738;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="標準サイズ (Ctrl + 0)" Click="ViewZoomReset_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <ToggleMenuFlyoutItem x:Name="MenuBgShowCheckBoxes" Text="項目チェックボックス" Click="MenuToggleCheckBoxes_Click"/>
                        <ToggleMenuFlyoutItem x:Name="MenuBgShowHidden" Text="隠しファイルを表示 (Ctrl+H)" Click="MenuToggleHidden_Click"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="並び替え">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8CB;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="名前" Click="SortByName_Click"/>
                        <MenuFlyoutItem Text="更新日時" Click="SortByDate_Click"/>
                        <MenuFlyoutItem Text="種類" Click="SortByType_Click"/>
                        <MenuFlyoutItem Text="サイズ" Click="SortBySize_Click"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="最新の情報に更新 (F5)" Click="RefreshButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="MenuBgPaste" Text="貼り付け (Ctrl+V)" Click="ContextMenuPaste_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="MenuBgNewSubItem" Text="新規作成">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="フォルダー (Ctrl+Shift+N)" Click="ContextMenuNewFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="テキスト ドキュメント" Click="ContextMenuNewTextFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="ターミナルで開く" Click="ContextMenuTerminal_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    <MenuFlyoutItem Text="プロパティ" Click="ContextMenuCurrentFolderProperties_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuFlyout>

                <!-- サイドバーアイテム用 DataTemplate -->
                <DataTemplate x:Key="SidebarItemTemplate">
                    <Grid HorizontalAlignment="Stretch" Padding="0">
                        <Grid Height="8" Visibility="{Binding SeparatorVisibility}" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Visibility="{Binding ItemContentVisibility}" HorizontalAlignment="Stretch" ColumnSpacing="6" MinHeight="32" Padding="6,2" Margin="0,1" Background="Transparent" DoubleTapped="SidebarItem_DoubleTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Width="16" Height="24" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="3" VerticalAlignment="Center" Visibility="{Binding ExpandIconVisibility}" Click="SidebarChevron_Click" ToolTipService.ToolTip="展開/折りたたみ">
                                <FontIcon Glyph="{Binding ExpandIconGlyph}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center" Margin="{Binding IndentMargin}">
                                <TextBlock Text="{Binding EmojiIcon}" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmojiIconVisibility}"/>
                                <Image Source="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ImageIconVisibility}"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            <FontIcon Grid.Column="3" Glyph="&#xE718;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Visibility="{Binding PinIconVisibility}" Margin="0,0,2,0"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- [Row 0] タイトルバー & タブ -->
            <RowDefinition Height="Auto"/> <!-- [Row 1] アドレス・パンくず・ナビゲーション -->
            <RowDefinition Height="*"/>    <!-- [Row 2] メインコンテンツ (サイドバー + リスト/ホーム + プレビュー) -->
            <RowDefinition Height="Auto"/> <!-- [Row 3] ステータスバー -->
        </Grid.RowDefinitions>

        <!-- カスタム壁紙・背景レイヤー (最背面) -->
        <Grid x:Name="BackgroundHostGrid" Grid.Row="0" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed">
            <Image x:Name="BackgroundImageHost"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            <!-- 視認性向上のためのテーマ連動ティントオーバーレイ -->
            <Border x:Name="BackgroundTintOverlay"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"/>
        </Grid>

        <!-- [Row 0] タイトルバー・タブ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="42" VerticalAlignment="Top">
            <TabView x:Name="MainTabView" VerticalAlignment="Stretch"
                     Background="Transparent"
                     CanReorderTabs="True"
                     CanDragTabs="True"
                     AllowDrop="True"
                     AddTabButtonClick="MainTabView_AddTabButtonClick"
                     TabCloseRequested="MainTabView_TabCloseRequested"
                     SelectionChanged="MainTabView_SelectionChanged"
                     TabDragStarting="MainTabView_TabDragStarting"
                     TabStripDragOver="MainTabView_TabStripDragOver"
                     TabStripDrop="MainTabView_TabStripDrop"
                     DragOver="MainTabView_TabStripDragOver"
                     Drop="MainTabView_TabStripDrop"
                     TabDroppedOutside="MainTabView_TabDroppedOutside"
                     TabDragCompleted="MainTabView_TabDragCompleted">
                <TabView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewStripBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#30FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundSelected" Color="#30FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" Color="#40FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundSelectedPointerOver" Color="#40FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#18FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundPointerOver" Color="#18FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#25FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundPressed" Color="#25FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrushSelected" Color="#30FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrushPointerOver" Color="#20FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#18FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#25FFFFFF"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewStripBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#CCFFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundSelected" Color="#CCFFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" Color="#E6FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundSelectedPointerOver" Color="#E6FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#33000000"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundPointerOver" Color="#33000000"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#44000000"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundPressed" Color="#44000000"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrushSelected" Color="#20000000"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrushPointerOver" Color="#15000000"/>
                                <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#20000000"/>
                                <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#30000000"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewStripBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#38383838"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundSelected" Color="#38383838"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" Color="#48484848"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundSelectedPointerOver" Color="#48484848"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#18FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundPointerOver" Color="#18FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#25FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBackgroundPressed" Color="#25FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrushSelected" Color="#33FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewItemBorderBrushPointerOver" Color="#20FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#18FFFFFF"/>
                                <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#25FFFFFF"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TabView.Resources>
                <TabView.TabStripHeader>
                    <Grid x:Name="TabStripHeaderRegion" Width="10" Background="Transparent"/>
                </TabView.TabStripHeader>
                <TabView.TabStripFooter>
                    <Grid x:Name="CustomDragRegion" MinWidth="180" HorizontalAlignment="Stretch" Background="Transparent"/>
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- [Row 1] アドレス・ナビゲーションバー (AddressBarControl) -->
        <nav:AddressBarControl x:Name="AddressBar" Grid.Row="1"/>

        <!-- [Row 2] メインコンテンツ (サイドバー + 中央コンテンツ + プレビューペイン) -->
        <Grid Grid.Row="2">
            <Grid x:Name="ExplorerContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="150" MaxWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="PreviewPaneColumn" Width="0" MinWidth="0" MaxWidth="450"/>
                </Grid.ColumnDefinitions>

                <!-- サイドバー -->
                <Grid x:Name="SidebarContainerGrid" Grid.Column="0" Background="Transparent" Tapped="SidebarContainer_Tapped">
                    <ListView x:Name="SidebarList" ItemsSource="{Binding SidebarItems}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SidebarList_ItemClick" Tapped="SidebarList_Tapped" ContextRequested="SidebarList_ContextRequested" Padding="4,4" ItemTemplate="{StaticResource SidebarItemTemplate}"
                              AllowDrop="True" DragOver="SidebarList_DragOver" Drop="SidebarList_Drop" DragLeave="SidebarList_DragLeave">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>

                <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Stretch"/>

                <!-- 中央コンテンツ (ツールバー + 列ヘッダー + 一覧/ホーム) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- アクションツールバー -->
                    <toolbar:ActionToolbarControl x:Name="ActionToolbar" Grid.Row="0"/>

                    <!-- リストヘッダー -->
                    <header:FileListHeaderControl x:Name="FileListHeader" Grid.Row="1"/>

                    <!-- ファイル一覧 & ホーム画面 -->
                    <Grid Grid.Row="2">
                        <!-- 通常フォルダー一覧 (ListView / GridView / Marquee) -->
                        <Grid x:Name="FileListContainer" PointerWheelChanged="FileListContainer_PointerWheelChanged"
                              AllowDrop="True" DragOver="FileList_DragOver" Drop="FileList_Drop" DragLeave="FileList_DragLeave">
                            <ListView x:Name="FileListView" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" ItemTemplate="{StaticResource DetailsItemTemplate}" DoubleTapped="FileListView_DoubleTapped" RightTapped="FileListView_RightTapped" KeyDown="FileListView_KeyDown" SelectionChanged="FileListView_SelectionChanged" ContextRequested="FileListView_ContextRequested" Padding="4,2"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled"
                                      CanDragItems="True" AllowDrop="True" DragItemsStarting="FileList_DragItemsStarting" DragItemsCompleted="FileList_DragItemsCompleted" DragOver="FileList_DragOver" Drop="FileList_Drop" DragLeave="FileList_DragLeave">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Width" Value="{Binding RowWidth}"/>
                                        <Setter Property="Margin" Value="6,1,6,1"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="CornerRadius" Value="4"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                            </ListView>
                            <GridView x:Name="FileGridView" Visibility="Collapsed" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="True" ItemClick="FileList_ItemClick" ItemTemplate="{StaticResource MediumIconsItemTemplate}" DoubleTapped="FileGridView_DoubleTapped" RightTapped="FileGridView_RightTapped" KeyDown="FileGridView_KeyDown" SelectionChanged="FileGridView_SelectionChanged" ContextRequested="FileGridView_ContextRequested" Padding="8,8"
                                      CanDragItems="True" AllowDrop="True" DragItemsStarting="FileList_DragItemsStarting" DragItemsCompleted="FileList_DragItemsCompleted" DragOver="FileList_DragOver" Drop="FileList_Drop" DragLeave="FileList_DragLeave">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="4,4,4,4"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="CornerRadius" Value="6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemContainerTransitions><TransitionCollection/></GridView.ItemContainerTransitions>
                            </GridView>
                            <!-- 選択用ラバーバンド枠 -->
                            <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                                <Rectangle x:Name="SelectionBox" Fill="#330078D4" Stroke="#0078D4" StrokeThickness="1" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>

                        <!-- ホーム画面専用ビュー (HomeViewControl) -->
                        <home:HomeViewControl x:Name="HomeView" Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <!-- プレビュー境界線 -->
                <Rectangle x:Name="PreviewSplitter" Grid.Column="3" Width="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Stretch" Visibility="Collapsed"/>

                <!-- プレビュー & 簡易プロパティペイン (PreviewPaneControl) -->
                <preview:PreviewPaneControl x:Name="PreviewPane" Grid.Column="4" Visibility="Collapsed"/>
            </Grid>
            <Grid x:Name="SettingsTabHostGrid" Visibility="Collapsed"/>
        </Grid>

        <!-- [Row 3] ステータスバー (StatusBarControl) -->
        <status:StatusBarControl x:Name="StatusBar" Grid.Row="3"/>

        <!-- ファイル転送進捗オーバーレイ -->
        <Grid x:Name="FileTransferOverlayGrid" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" Background="#26000000" Canvas.ZIndex="500">
            <dialogs:FileTransferDialog x:Name="TransferDialogControl" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
