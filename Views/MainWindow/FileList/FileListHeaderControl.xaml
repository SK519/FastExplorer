<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FastExplorer.Views.MainWindow.FileList.FileListHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FastExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer x:Name="FileListHeaderScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="FileListHeaderGrid" Orientation="Horizontal" HorizontalAlignment="Left" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4,4,12,4">
            <Border Width="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                <CheckBox x:Name="SelectAllCheckBox"
                          MinWidth="0" MinHeight="0" Padding="0" Margin="8,0,8,0"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsThreeState="True"
                          Click="SelectAllCheckBox_Click"
                          ToolTipService.ToolTip="すべて選択 / 選択解除"/>
            </Border>
            <Border Width="28"/>

            <!-- 名前列ヘッダー + リサイズバー -->
            <Grid x:Name="HeaderNameContainer" Width="280">
                <Button Content="名前" Click="SortByName_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Padding="4,2"/>
                <controls:ColumnResizeHandle x:Name="ResizeHandleName" Width="16" HorizontalAlignment="Right" Margin="0,0,-8,0"
                                             PointerPressed="ResizeHandleName_PointerPressed"
                                             PointerMoved="ResizeHandle_PointerMoved"
                                             PointerReleased="ResizeHandle_PointerReleased"
                                             PointerCaptureLost="ResizeHandle_PointerCaptureLost"
                                             DoubleTapped="ResizeHandleName_DoubleTapped"/>
            </Grid>

            <!-- 更新日時/元の場所列ヘッダー + リサイズバー -->
            <Grid x:Name="HeaderDateContainer" Width="170">
                <Button x:Name="BtnHeaderDate" Content="更新日時" Click="SortByDate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Padding="4,2"/>
                <controls:ColumnResizeHandle x:Name="ResizeHandleDate" Width="16" HorizontalAlignment="Right" Margin="0,0,-8,0"
                                             PointerPressed="ResizeHandleDate_PointerPressed"
                                             PointerMoved="ResizeHandle_PointerMoved"
                                             PointerReleased="ResizeHandle_PointerReleased"
                                             PointerCaptureLost="ResizeHandle_PointerCaptureLost"
                                             DoubleTapped="ResizeHandleDate_DoubleTapped"/>
            </Grid>

            <!-- 種類/削除日時列ヘッダー + リサイズバー -->
            <Grid x:Name="HeaderTypeContainer" Width="140">
                <Button x:Name="BtnHeaderType" Content="種類" Click="SortByType_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Padding="4,2"/>
                <controls:ColumnResizeHandle x:Name="ResizeHandleType" Width="16" HorizontalAlignment="Right" Margin="0,0,-8,0"
                                             PointerPressed="ResizeHandleType_PointerPressed"
                                             PointerMoved="ResizeHandle_PointerMoved"
                                             PointerReleased="ResizeHandle_PointerReleased"
                                             PointerCaptureLost="ResizeHandle_PointerCaptureLost"
                                             DoubleTapped="ResizeHandleType_DoubleTapped"/>
            </Grid>

            <!-- サイズ列ヘッダー + リサイズバー -->
            <Grid x:Name="HeaderSizeContainer" Width="100">
                <Button Content="サイズ" Click="SortBySize_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Padding="4,2"/>
                <controls:ColumnResizeHandle x:Name="ResizeHandleSize" Width="16" HorizontalAlignment="Right" Margin="0,0,-8,0"
                                             PointerPressed="ResizeHandleSize_PointerPressed"
                                             PointerMoved="ResizeHandle_PointerMoved"
                                             PointerReleased="ResizeHandle_PointerReleased"
                                             PointerCaptureLost="ResizeHandle_PointerCaptureLost"
                                             DoubleTapped="ResizeHandleSize_DoubleTapped"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
