<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FastExplorer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FastExplorer">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/ContextMenuResources.xaml"/>
                <ResourceDictionary Source="ms-appx:///Resources/FileItemDetailsTemplates.xaml"/>
                <ResourceDictionary Source="ms-appx:///Resources/FileItemGridTemplates.xaml"/>
                <ResourceDictionary Source="ms-appx:///Resources/FileItemGridScaledTemplates.xaml"/>
                <ResourceDictionary Source="ms-appx:///Resources/LayoutTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- ドロップダウン・メニュー・フライアウト不透明ソリッド背景 (壁紙透過防止) -->
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#282828"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#444444"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#282828"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#444444"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#282828"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="#444444"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#282828"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBorderBrush" Color="#444444"/>

                    <!-- ToolTip 共通リソース (角丸8px・すりガラス) -->
                    <CornerRadius x:Key="ToolTipCornerRadius">8</CornerRadius>
                    <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
                    <AcrylicBrush x:Key="ToolTipBackgroundBrush" TintColor="#242424" TintOpacity="0.80" FallbackColor="#F0242424" TintLuminosityOpacity="0.90"/>
                    <StaticResource x:Key="ToolTipBackground" ResourceKey="ToolTipBackgroundBrush"/>
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#4DFFFFFF"/>
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF"/>

                    <!-- TabView 透過 & すりガラス調スタイル -->
                    <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewStripBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#30FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#28FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrushSelected" Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrushPointerOver" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#28FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- ドロップダウン・メニュー・フライアウト不透明ソリッド背景 (壁紙透過防止) -->
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FDFDFD"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FDFDFD"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FDFDFD"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#FDFDFD"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBorderBrush" Color="#E5E5E5"/>

                    <!-- ToolTip 共通リソース (角丸8px・すりガラス) -->
                    <CornerRadius x:Key="ToolTipCornerRadius">8</CornerRadius>
                    <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
                    <AcrylicBrush x:Key="ToolTipBackgroundBrush" TintColor="#FAFAFA" TintOpacity="0.85" FallbackColor="#F0FAFAFA" TintLuminosityOpacity="0.95"/>
                    <StaticResource x:Key="ToolTipBackground" ResourceKey="ToolTipBackgroundBrush"/>
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#26000000"/>
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#1C1C1C"/>

                    <!-- TabView 透過 & すりガラス調スタイル -->
                    <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewStripBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#CCFFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#44FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#66FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrushSelected" Color="#1A000000"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrushPointerOver" Color="#0D000000"/>
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#22000000"/>
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#33000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- ドロップダウン・メニュー・フライアウト不透明ソリッド背景 (壁紙透過防止) -->
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#282828"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#444444"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#282828"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#444444"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#282828"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="#444444"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#282828"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBorderBrush" Color="#444444"/>

                    <!-- ToolTip 共通リソース (角丸8px・すりガラス) -->
                    <CornerRadius x:Key="ToolTipCornerRadius">8</CornerRadius>
                    <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
                    <AcrylicBrush x:Key="ToolTipBackgroundBrush" TintColor="#242424" TintOpacity="0.80" FallbackColor="#F0242424" TintLuminosityOpacity="0.90"/>
                    <StaticResource x:Key="ToolTipBackground" ResourceKey="ToolTipBackgroundBrush"/>
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#4DFFFFFF"/>
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF"/>

                    <!-- TabView 透過 & すりガラス調スタイル -->
                    <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewStripBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#38383838"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#30FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrushSelected" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrushPointerOver" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#30FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- モダンツールチップスタイル (角丸8px・アクリルすりガラスぼかし) -->
            <Style x:Key="DefaultToolTipStyle" TargetType="ToolTip">
                <Setter Property="Background" Value="{ThemeResource ToolTipBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource ToolTipForeground}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ToolTipBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  MaxWidth="{TemplateBinding MaxWidth}"
                                                  TextWrapping="Wrap"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}"/>

            <Style x:Key="ContextMenuItemButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
