<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FastExplorer.Views.MainWindow.Toolbar.ActionToolbarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Resources/LayoutTemplates.xaml"/>
    </UserControl.Resources>

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,3">
        <Grid>
            <!-- 1. 通常フォルダー用ツールバーパネル -->
            <StackPanel x:Name="StandardToolbarPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Visible">
                <Button x:Name="ToolbarBtnNewMenu" Height="34" Padding="8,0" Background="Transparent" BorderThickness="0" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="新規作成" FontSize="12" FontWeight="SemiBold"/>
                        <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="NewItemFlyout" Opening="NewItemFlyout_Opening" Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="フォルダー (Ctrl+Shift+N)" Click="NewFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="テキスト ドキュメント" Click="NewTextFile_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0"/>
                <Button x:Name="ToolbarBtnCut" Style="{StaticResource HeaderIconButtonStyle}" Click="Cut_Click" ToolTipService.ToolTip="切り取り (Ctrl+X)"><FontIcon Glyph="&#xE8C6;" FontSize="14"/></Button>
                <Button x:Name="ToolbarBtnCopy" Style="{StaticResource HeaderIconButtonStyle}" Click="Copy_Click" ToolTipService.ToolTip="コピー (Ctrl+C)"><FontIcon Glyph="&#xE8C8;" FontSize="14"/></Button>
                <Button x:Name="ToolbarBtnPaste" Style="{StaticResource HeaderIconButtonStyle}" Click="Paste_Click" ToolTipService.ToolTip="貼り付け (Ctrl+V)"><FontIcon Glyph="&#xE77F;" FontSize="14"/></Button>
                <Button x:Name="ToolbarBtnRename" Style="{StaticResource HeaderIconButtonStyle}" Click="Rename_Click" ToolTipService.ToolTip="名前の変更 (F2)"><FontIcon Glyph="&#xE8AC;" FontSize="14"/></Button>
                <Button x:Name="ToolbarBtnDelete" Style="{StaticResource HeaderIconButtonStyle}" Click="Delete_Click" ToolTipService.ToolTip="削除"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                <Button x:Name="ToolbarBtnProperties" Style="{StaticResource HeaderIconButtonStyle}" Click="Properties_Click" ToolTipService.ToolTip="プロパティ"><FontIcon Glyph="&#xE90F;" FontSize="14"/></Button>
            </StackPanel>

            <!-- 2. ごみ箱用ツールバーパネル -->
            <StackPanel x:Name="RecycleBinToolbarPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                <Button x:Name="ToolbarBtnRestore" Height="34" Padding="8,0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="Restore_Click" ToolTipService.ToolTip="選択したすべての項目を元の場所に戻します">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE777;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="元に戻す" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ToolbarBtnEmptyRecycleBin" Height="34" Padding="8,0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="EmptyRecycleBin_Click" ToolTipService.ToolTip="ごみ箱を空にしてすべての項目を完全に削除します">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="OrangeRed"/>
                        <TextBlock Text="ごみ箱を空にする" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0"/>
                <Button x:Name="ToolbarBtnRecycleDelete" Style="{StaticResource HeaderIconButtonStyle}" Click="Delete_Click" ToolTipService.ToolTip="完全に削除"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                <Button x:Name="ToolbarBtnRecycleProperties" Style="{StaticResource HeaderIconButtonStyle}" Click="Properties_Click" ToolTipService.ToolTip="プロパティ"><FontIcon Glyph="&#xE90F;" FontSize="14"/></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="ToolbarBtnTogglePreview" Style="{StaticResource HeaderIconButtonStyle}" Click="TogglePreview_Click" ToolTipService.ToolTip="詳細とプレビュー (Alt+P)"><FontIcon Glyph="&#xE8FF;" FontSize="14"/></Button>
                <Rectangle Width="1" Height="18" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0"/>
                <Button x:Name="ToolbarBtnViewMenu" Height="34" Padding="8,0" Background="Transparent" BorderThickness="0" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A9;" FontSize="14"/><TextBlock Text="表示" FontSize="12" FontWeight="SemiBold"/><FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ToolbarViewFlyout" Opening="ViewMenuFlyout_Opening" Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="16,14"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinWidth" Value="390"/><Setter Property="Width" Value="390"/>
                                    <Setter Property="IsDefaultShadowEnabled" Value="True"/>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Spacing="14" Width="358">
                                <!-- レイアウト切替 -->
                                <TextBlock Text="レイアウト" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="BtnFlyoutDetails" Grid.Column="0" Click="ViewModeDetails_Click" HorizontalAlignment="Stretch" Height="48" CornerRadius="6" Padding="2,4" ToolTipService.ToolTip="詳細">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon Glyph="&#xE8BC;" FontSize="16"/><TextBlock Text="詳細" FontSize="11"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnFlyoutList" Grid.Column="1" Click="ViewModeList_Click" HorizontalAlignment="Stretch" Height="48" CornerRadius="6" Padding="2,4" ToolTipService.ToolTip="一覧">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon Glyph="&#xE8C0;" FontSize="16"/><TextBlock Text="一覧" FontSize="11"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnFlyoutContent" Grid.Column="2" Click="ViewModeContent_Click" HorizontalAlignment="Stretch" Height="48" CornerRadius="6" Padding="2,4" ToolTipService.ToolTip="カード">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon Glyph="&#xE8D2;" FontSize="16"/><TextBlock Text="カード" FontSize="11"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnFlyoutGrid" Grid.Column="3" Click="ViewModeGrid_Click" HorizontalAlignment="Stretch" Height="48" CornerRadius="6" Padding="2,4" ToolTipService.ToolTip="アイコン">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon Glyph="&#xE8A7;" FontSize="16"/><TextBlock Text="アイコン" FontSize="11"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnFlyoutTiles" Grid.Column="4" Click="ViewModeTiles_Click" HorizontalAlignment="Stretch" Height="48" CornerRadius="6" Padding="2,4" ToolTipService.ToolTip="タイル">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon Glyph="&#xE8A9;" FontSize="16"/><TextBlock Text="タイル" FontSize="11"/></StackPanel>
                                    </Button>
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>
                                <!-- サイズ切替ボタン -->
                                <TextBlock Text="サイズ" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="BtnSizeSmall" Grid.Column="0" Click="ViewSizeSmall_Click" HorizontalAlignment="Stretch" Height="44" CornerRadius="6" Padding="2,2" ToolTipService.ToolTip="小アイコン">
                                        <TextBlock Text="小" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="BtnSizeMedium" Grid.Column="1" Click="ViewSizeMedium_Click" HorizontalAlignment="Stretch" Height="44" CornerRadius="6" Padding="2,2" ToolTipService.ToolTip="中アイコン (イラスト)">
                                        <TextBlock Text="中" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="BtnSizeLarge" Grid.Column="2" Click="ViewSizeLarge_Click" HorizontalAlignment="Stretch" Height="44" CornerRadius="6" Padding="2,2" ToolTipService.ToolTip="大アイコン (イラスト)">
                                        <TextBlock Text="大" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="BtnSizeExtraLarge" Grid.Column="3" Click="ViewSizeExtraLarge_Click" HorizontalAlignment="Stretch" Height="44" CornerRadius="6" Padding="2,2" ToolTipService.ToolTip="特大アイコン (イラスト)">
                                        <TextBlock Text="特大" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>
                                <!-- ToggleSwitch コントロール -->
                                <ToggleSwitch x:Name="CheckShowItemCheckBoxes" Header="項目チェックボックス" OnContent="オン" OffContent="オフ" FontSize="13" Toggled="CheckShowItemCheckBoxes_Toggled"/>
                                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2"/>
                                <ToggleSwitch x:Name="CheckShowHiddenFiles" Header="隠しファイル" OnContent="オン" OffContent="オフ" FontSize="13" Toggled="CheckShowHiddenFiles_Toggled"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
