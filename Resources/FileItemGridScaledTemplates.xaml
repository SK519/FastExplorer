<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 11. 特大アイコン (大: 230x240) テンプレート -->
    <DataTemplate x:Key="ExtraLargeIconsLargeItemTemplate">
        <Grid Width="230" Height="240" Padding="8,8" Opacity="{Binding Opacity}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Visibility="{Binding CheckBoxVisibility, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      MinWidth="0" MinHeight="0" Padding="0" Margin="8,8,0,0"/>

            <Image Grid.Row="0"
                   Source="{Binding Icon}"
                   Width="180" Height="180"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <Grid Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Visibility="{Binding DisplayNameVisibility}"/>
                <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                         FontSize="13"
                         Height="30"
                         Padding="4,2"
                         HorizontalAlignment="Stretch"
                         Visibility="{Binding RenameBoxVisibility, FallbackValue=Collapsed}"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus"
                         Loaded="RenameBox_Loaded"/>
            </Grid>
        </Grid>
    </DataTemplate>

